# core.autocrlf is on for Windows checkouts. These files must not follow it.
*.sh            text eol=lf
android/gradlew text eol=lf
*.bat           text eol=crlf
*.jar           binary

# The golden Android session is compared byte for byte, by the Python tests and
# by the app's :format tests. core.autocrlf would rewrite its line endings on
# checkout (CRLF CSVs to LF, LF JSON to CRLF), so git must not touch them.
tests/fixtures/android_session/** -text
