<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared, frozen file: written once by the design stage so no workstream has to edit it.
    A change needs the orchestrator (android/ARCHITECTURE.md, "Shared files").
    Play-clean by decision: no background location, no wake lock, no battery-exemption request,
    no all-packages query, no Wi-Fi state (no SSID or BSSID), no privileged phone state.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Every measurement comes from the telephony stack. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android returns no cell info without precise location; on Android 12+ both are requested together. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional: only the push CellInfoListener needs it. Never used to read an identifier. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The session runs in a foreground service of type location, started from the visible screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ping and download, bound to the cellular network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:name=".app.FieldTapApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldTap"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported; its Stop and Mark notification actions are PendingIntents to itself. -->
        <service
            android:name=".service.SessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Shares export zips and probe JSON from cache/exports/ only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
