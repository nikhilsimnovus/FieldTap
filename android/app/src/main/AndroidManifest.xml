<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared, frozen file: written once by the design stage so no workstream has to edit it.
    A change needs the orchestrator (android/ARCHITECTURE.md, "Shared files").
    Play-clean by decision: no background location, no wake lock, no battery-exemption request,
    no all-packages query, no Wi-Fi state (no SSID or BSSID), no privileged phone state.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Every measurement comes from the telephony stack: a phone without it has nothing to record. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android returns no cell info without precise location; on Android 12+ both are requested together. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional: only the push CellInfoListener needs it. Never used to read an identifier. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The session runs in a foreground service of type location, started from the visible screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ping and download, bound to the cellular network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
        Package visibility (API 30+): the capability screen's PackageScanner asks PackageManager whether any
        known root-manager app is installed, one of the passive root signals. This names exactly those
        packages (capability-spec.md §7) and is NOT a QUERY_ALL_PACKAGES query, keeping the app play-clean.
    -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.noshufou.android.su.elite" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.yellowes.su" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.kingo.root" />
        <package android:name="com.zachspong.temprootremovejb" />
        <package android:name="com.ramdroid.appquarantine" />
    </queries>

    <!--
        Sessions, settings and consent never leave the phone except as a shared zip (decision 3):
        no cloud backup, no device-to-device transfer, no adb backup.
    -->
    <application
        android:name=".app.FieldTapApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldTap"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported; its Stop and Mark notification actions are PendingIntents to itself. -->
        <service
            android:name=".service.SessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Shares export zips and probe JSON from cache/exports/ only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
