<?xml version="1.0" encoding="utf-8"?>
<!--
    Full backup (adb backup, and cloud backup where data_extraction_rules.xml does not apply) excludes
    everything, like data_extraction_rules.xml (android/ARCHITECTURE.md, decision 3).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
