<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later: nothing of FieldTap goes to cloud backup or to a new phone in a device-to-device
    transfer (android/ARCHITECTURE.md, decision 3). Sessions leave the phone only as a zip the user shares.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
